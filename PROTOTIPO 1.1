var edit={type:null, idx:null, key:null};
function isDate(h){return h.toLowerCase().indexOf('fecha')!==-1}
function inputHTML(id,label,val){var t=isDate(label)?'date':'text';var long=label.toLowerCase().indexOf('detalle')!==-1||label.toLowerCase().indexOf('descripcion')!==-1||label.toLowerCase().indexOf('observ')!==-1;return '<div style="'+(long?'grid-column:1 / -1':'')+'"><label class="form-label">'+label+'</label>'+(long?'<textarea id="'+id+'" class="input" style="min-height:60px">'+(val||'')+'</textarea>':'<input id="'+id+'" class="input" type="'+t+'" value="'+(val||'')+'">')+'</div>';}
function renderInicio(){var tl=document.getElementById('mini-eq');if(tl){tl.innerHTML=MADRE.slice(0,2).map(function(r){return '<div style="background:#fff;border:1px solid #eef0f5;padding:8px;border-radius:8px;display:flex;gap:8px"><div style="width:26px;height:26px;border-radius:6px;background:'+(r[5]=='CERRADO'?'#f0fdf4':'#fef2f2')+';display:flex;align-items:center;justify-content:center;font-size:9px">'+(r[5]=='CERRADO'?'OK':'--')+'</div><div style="flex:1"><b style="font-size:10px">'+r[1]+'</b><br><span style="font-size:9px;color:#6b7280">'+r[8]+' > '+r[9]+'</span></div></div>'}).join('')}}
function openDash(){var c=MADRE.filter(function(r){return r[5]=='CERRADO'}).length;var p=Math.round(c/MADRE.length*100);document.getElementById('dashHead').innerHTML='<div style="display:flex;justify-content:space-between"><div><h4 style="font-weight:800">Dashboard Ejecutivo - Bitacora e Indicadores Mismo Menu '+p+' por ciento</h4><p style="font-size:10px;color:#6b7280">Bitacora y indicadores permanecen en mismo menu - Cada uno con 2 submenus: Registrar + Indicadores validacion checkbox</p></div><span class="badge '+(p>=60?'ok':'nook')+'">'+p+' por ciento</span></div>';document.getElementById('dashContent').innerHTML='<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px"><div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px;text-align:center"><b>'+MADRE.length+'</b><br><span style="font-size:9px;color:#64748b">Matriz Madre</span></div><div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px;text-align:center"><b style="color:#166534">'+p+' por ciento</b><br><span style="font-size:9px;color:#64748b">Cumplimiento</span></div><div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px;text-align:center"><b>BI Mismo Menu</b><br><span style="font-size:9px;color:#64748b">Bitacora e Indicadores</span></div><div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px;text-align:center"><b>Checkbox</b><br><span style="font-size:9px;color:#64748b">Indicadores Validacion</span></div></div>'}
function openMadre(){var c=MADRE.filter(function(r){return r[5]=='CERRADO'}).length;var p=Math.round(c/MADRE.length*100);document.getElementById('madreHead').innerHTML='<div style="display:flex;justify-content:space-between"><div><h4 style="font-weight:800">Matriz Madre '+MADRE.length+' Regs '+p+' por ciento - Bitacora e Indicadores Mismo Menu</h4></div><span class="badge '+(p>=60?'ok':'nook')+'">'+p+' por ciento</span></div>';document.getElementById('thMadre').innerHTML=H_MADRE.map(function(h){return '<th>'+h+'</th>'}).join('')+'<th>Acciones</th>';document.getElementById('tbMadre').innerHTML=MADRE.map(function(r,i){return '<tr>'+r.map(function(c,ci){return '<td>'+([5,10].indexOf(ci)!==-1?'<span class="badge '+(c=='CERRADO'||c=='Operativo'||c=='Exitoso'?'ok':'nook')+'">'+c+'</span>':c)+'</td>'}).join('')+'<td><div style="display:flex;gap:6px"><button class="btn btn-ghost" style="padding:6px 8px" onclick="editMadre('+i+')">Editar</button><button class="btn btn-danger" style="padding:6px 8px" onclick="delMadre('+i+')">Borrar</button></div></td></tr>'}).join('')}
function openOrig(key){var o=ORIG[key];document.getElementById('head-'+key).innerHTML='<div style="display:flex;justify-content:space-between"><div><h4 style="font-weight:800">'+o.title+' - Registrar - Mismo Menu Bitacora e Indicadores</h4><p style="font-size:10px;color:#6b7280">Submenu 1: Registrar - Bitacora e Indicadores permanecen en mismo menu</p></div><button class="btn btn-dark" style="width:auto" onclick="openModalOrig(\''+key+'\')">+ Registrar Nuevo</button></div>';document.getElementById('th-'+key).innerHTML='<tr>'+o.headers.map(function(h){return '<th>'+h+'</th>'}).join('')+'<th>Acciones</th></tr>';document.getElementById('tb-'+key).innerHTML=o.data.map(function(r,i){return '<tr>'+r.map(function(c){return '<td>'+c+'</td>'}).join('')+'<td><div style="display:flex;gap:6px"><button class="btn btn-ghost" style="padding:6px 8px" onclick="editOrig(\''+key+'\','+i+')">Editar</button><button class="btn btn-danger" style="padding:6px 8px" onclick="delOrig(\''+key+'\','+i+')">Borrar</button></div></td></tr>'}).join('')}
function openValid(key){var list=VALID[key];var total=list.length;var ok=list.filter(function(x){return x.check}).length;var p=Math.round(ok/total*100);var content=document.getElementById('valid-'+key+'-content');if(!content)return;content.innerHTML='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><div><h4 style="font-weight:800">'+ORIG[key].title.split(' - ')[0]+' - Indicadores de Validacion Checkbox - Mismo Menu</h4><p style="font-size:10px;color:#6b7280;margin-top:4px">Bitacora e Indicadores mismo menu - Cada bitacora tiene 2 submenus: Registrar + Indicadores validacion como checkbox - Ver cuales estan</p></div><span class="badge '+(p>=60?'ok':'nook')+'">'+ok+'/'+total+' - '+p+' por ciento validado</span></div><div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:16px"><div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px;text-align:center"><b>'+total+'</b><br><span style="font-size:9px;color:#64748b">Total Indicadores</span></div><div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px;text-align:center"><b style="color:#166534">'+ok+'</b><br><span style="font-size:9px;color:#64748b">Validados Checkbox</span></div><div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px;text-align:center"><b style="color:#991b1b">'+(total-ok)+'</b><br><span style="font-size:9px;color:#64748b">Pendientes Checkbox</span></div></div><div class="check-grid">'+list.map(function(item,idx){return '<label class="check-item" style="'+(item.check?'background:#f0fdf4;border-color:#bbf7d0':'background:#fef2f2;border-color:#fecaca')+'"><input type="checkbox" '+(item.check?'checked':'')+' onchange="toggleValid(\''+key+'\','+idx+',this.checked)"><div style="flex:1"><b style="font-size:11px;display:block">'+item.name+'</b><span style="font-size:9px;color:#6b7280">'+item.desc+'</span></div><span class="badge '+(item.check?'ok':'nook')+'">'+(item.check?'Validado':'Pendiente')+'</span></label>'}).join('')+'</div><div style="margin-top:16px;display:flex;gap:10px"><button class="btn btn-dark" onclick="validateAll(\''+key+'\')">Validar Todos Checkbox</button><button class="btn btn-ghost" onclick="openF(\''+key+'\')">Ir a Registrar '+ORIG[key].title.split(' - ')[0]+'</button></div>'}
function toggleValid(key,idx,checked){VALID[key][idx].check=checked;openValid(key);toast((checked?'Validado':'Pendiente')+' - '+VALID[key][idx].name)}
function validateAll(key){VALID[key].forEach(function(x){x.check=true});openValid(key);toast('Todos validados checkbox - '+key)}
function renderCatalogo(){var f=document.getElementById('sCat')?document.getElementById('sCat').value.toLowerCase():'';var list=MADRE.filter(function(r){return!f||r.join(' ').toLowerCase().indexOf(f)!==-1});document.getElementById('catalogoGrid').innerHTML=list.map(function(r){return '<div style="background:#fff;border:1px solid #eef0f5;border-radius:12px;padding:12px"><div style="display:flex;justify-content:space-between;margin-bottom:8px"><b style="font-size:11px">'+r[1]+'</b><span class="badge '+(r[10]=='Operativo'?'ok':'nook')+'">'+r[10]+'</span></div><div style="font-size:9px;color:#6b7280"><div><b>Codigo:</b> '+r[0]+'</div><div><b>Responsable:</b> '+r[4]+'</div><div><b>Inicio:</b> '+r[8]+' Fin: '+r[9]+'</div></div></div>'}).join('')}
function renderEquipos(){var f=document.getElementById('sEq')?document.getElementById('sEq').value.toLowerCase():'';var list=MADRE.filter(function(r){return!f||r.join(' ').toLowerCase().indexOf(f)!==-1});document.getElementById('tbEq').innerHTML=list.map(function(r){return '<tr><td><b>'+r[0]+'</b></td><td>'+r[1]+'</td><td>'+r[8]+'</td><td>'+r[9]+'</td><td>'+r[4]+'</td><td><span class="badge '+(r[10]=='Operativo'?'ok':'nook')+'">'+r[10]+'</span></td><td><div style="display:flex;gap:6px"><button class="btn btn-ghost" style="padding:6px 8px" onclick="editMadre('+MADRE.indexOf(r)+')">Editar</button></div></td></tr>'}).join('');renderCatalogo()}
function openModalMadre(){document.getElementById('modal').classList.add('open');document.getElementById('mTitle').innerText='Nuevo Registro - Bitacora e Indicadores Mismo Menu';document.getElementById('mForm').innerHTML='<div class="form-grid">'+H_MADRE.map(function(h){return inputHTML('f_'+h,h,'')}).join('')+'</div>';edit={type:'madre',idx:null}}
function editMadre(i){openModalMadre();H_MADRE.forEach(function(h,ci){var el=document.getElementById('f_'+h);if(el)el.value=MADRE[i][ci]});edit={type:'madre',idx:i}}
function delMadre(i){if(confirm('Borrar '+MADRE[i][0]+'?')){MADRE.splice(i,1);openMadre();renderEquipos();renderInicio();toast('Borrado OK')}}
function openModalOrig(key){document.getElementById('modal').classList.add('open');document.getElementById('mTitle').innerText='Registrar - '+ORIG[key].title+' - Bitacora e Indicadores Mismo Menu';document.getElementById('mForm').innerHTML='<div class="form-grid">'+ORIG[key].headers.map(function(h){return inputHTML('fo_'+h,h,'')}).join('')+'</div>';edit={type:'orig',key:key,idx:null}}
function editOrig(key,i){openModalOrig(key);ORIG[key].headers.forEach(function(h,ci){var el=document.getElementById('fo_'+h);if(el)el.value=ORIG[key].data[i][ci]||''});edit={type:'orig',key:key,idx:i}}
function delOrig(key,i){if(confirm('Borrar registro?')){ORIG[key].data.splice(i,1);openOrig(key);toast('Borrado OK')}}
function saveM(){if(edit.type=='madre'){var v=H_MADRE.map(function(h){var el=document.getElementById('f_'+h);return el?el.value:''});if(edit.idx!=null){MADRE[edit.idx]=v}else{MADRE.push(v)}closeM();openMadre();renderEquipos();renderInicio();toast('Guardado OK')}if(edit.type=='orig'){var v=ORIG[edit.key].headers.map(function(h){var el=document.getElementById('fo_'+h);return el?el.value:''});if(edit.idx!=null){ORIG[edit.key].data[edit.idx]=v}else{ORIG[edit.key].data.push(v)}closeM();openOrig(edit.key);toast('Guardado OK - Registrar Bitacora e Indicadores Mismo Menu')}}
function closeM(){document.getElementById('modal').classList.remove('open')}
function toast(m){document.getElementById('toastMsg').innerText=m;var t=document.getElementById('toast');t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2600)}
function exportExcel(){var csv=H_MADRE.join(',')+'\n'+MADRE.map(function(r){return r.map(function(c){return '"'+c.replace(/"/g,'""')+'"'}).join(',')}).join('\n');var blob=new Blob([csv],{type:'text/csv'});var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download='Matriz_Bitacora_Indicadores_Mismo_Menu.csv';a.click();toast('Excel Exportado')}
document.addEventListener('DOMContentLoaded',function(){renderInicio();renderEquipos();openDash();console.log('BITACORA E INDICADORES MISMO MENU - Cada uno con 2 submenus: Registrar + Indicadores Validacion Checkbox - Solo ese cambio - Listo')})
</script>
</body>
</html>
